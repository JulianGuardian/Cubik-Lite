# Copia este archivo a .env:
#   cp .env.example .env
#
# GEMINI_API_KEY es OPCIONAL. Si la defines, el proyecto usa la API de Gemini.
# Si la dejas vacia o con el placeholder, usa automaticamente un modelo local
# via Ollama (qwen2.5:14b para chat, nomic-embed-text para embeddings), asi
# cada quien puede probar con lo que tenga disponible. El agente ADK
# (agents/cubik_tutor/) usa esta misma variable, no necesita otra.
#
# Consigue una key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=PEGA_TU_API_KEY_AQUI

# Opcionales: solo si quieres sobreescribir los modelos por defecto.
# GEMINI_CHAT_MODEL=gemini/gemini-3.6-flash
# GEMINI_EMBED_MODEL=gemini/gemini-embedding-001
# LOCAL_CHAT_MODEL=ollama_chat/qwen2.5:14b
# LOCAL_EMBED_MODEL=ollama/nomic-embed-text
